# ---------------------------------------------------------
# Eptoflow backend environment
# ---------------------------------------------------------
NODE_ENV=development
PORT=4000

# Postgres connection URL
DATABASE_URL=postgres://eptoflow:eptoflow_pw@localhost:5432/eptoflow

# JWT secrets (use strong random 32+ char strings in production)
JWT_SECRET=replace_me_with_strong_random_32_plus_chars
ADMIN_JWT_SECRET=replace_me_admin_strong_random_32_plus_chars
DEVICE_JWT_SECRET=replace_me_device_strong_random_32_plus_chars

JWT_EXPIRES_IN=7d
DEVICE_JWT_EXPIRES_IN=30d

# CORS - comma-separated origins
ALLOWED_ORIGINS=http://localhost:3000

# Default admin seeded by `npm run seed`
DEFAULT_ADMIN_EMAIL=admin@eptoflow.local
DEFAULT_ADMIN_PASSWORD=ChangeMe!Admin123

# Device / subscription tuning
HEARTBEAT_OFFLINE_SECONDS=120
SUBSCRIPTION_DAYS=30
